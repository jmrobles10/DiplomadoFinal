      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Cada línea del JSONL es un fragmento {id, content, metadata}\nconst raw = $input.first().json.data || '';\nconst lines = raw.split(/\\r?\\n/).filter(l => l.trim().length > 0);\nconst items = [];\nfor (const line of lines) {\n  try {\n    const d = JSON.parse(line);\n    items.push({ json: { id: d.id, content: d.content, metadata: d.metadata || {} } });\n  } catch (e) { /* línea corrupta: se ignora */ }\n}\nreturn items;"
      },
      "id": "una-fila-por-fragmento",
      "name": "Una fila por fragmento",
